# SERVER ONLY: Neon pooled connection URL, with TLS. Never use VITE_DATABASE_URL.
# Use a separate Neon branch for Vercel preview deployments.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Exact public origin; no trailing path. Set separately per deployment environment.
APP_ORIGIN="https://your-project.vercel.app"

# Public build-time switch. Production defaults to server if omitted.
# Local npm run dev defaults to the browser-only demo; use vercel dev for API routes.
VITE_ACCOUNT_MODE="server"
# Existing market feed (availability and commercial usage rights depend on provider).
VITE_CRYPTO_API_BASE_URL="https://api.coinpaprika.com/v1"

# Email notifications — SERVER ONLY. Use a verified Resend sending domain.
# Leave these unset to keep delivery disabled; previews still work in /#emails.
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_REPLY_TO=""
# At least 32 random characters. Protects /api/email-dispatch retry worker.
# Configure your own scheduler; no recurring job is automatically enabled.
CRON_SECRET=""
