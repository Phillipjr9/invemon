# SERVER ONLY: Neon pooled connection URL, with TLS. Never use VITE_DATABASE_URL.
# Use a separate Neon branch for Vercel preview deployments.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Exact public origin; no trailing path. Set separately per deployment environment.
APP_ORIGIN="https://www.invemon.org"

# Public build-time switch. Production defaults to server if omitted.
# Local npm run dev defaults to the browser-only demo; use vercel dev for API routes.
VITE_ACCOUNT_MODE="server"
# Existing market feed (availability and commercial usage rights depend on provider).
VITE_CRYPTO_API_BASE_URL="https://api.coinpaprika.com/v1"

# Email notifications — SERVER ONLY. Use a verified Resend sending domain.
# Leave these unset to keep delivery disabled; previews still work in /#emails.
RESEND_API_KEY=""
EMAIL_FROM="Invemon <noreply@invemon.org>"
EMAIL_REPLY_TO="support@invemon.org"
# At least 32 random characters. Protects /api/email-dispatch retry worker.
# Configure your own scheduler; no recurring job is automatically enabled.
CRON_SECRET=""

# Restricted support staff: comma-separated app_users UUIDs, never emails.
# Accounts also require verified email and enabled MFA with an MFA-verified session.
# Empty disables staff access.
SUPPORT_AGENT_IDS=""
# SERVER ONLY: independent random 32+ character bearer secret for /api/health
# and /api/maintenance. Do not reuse session tokens or expose to browser code.
OPS_SECRET=""
# Cleanup is dry-run by default. Enable only after reviewing docs/OPERATIONS.md.
MAINTENANCE_WRITES_ENABLED="false"

# SERVER ONLY: 32 random bytes encoded as exactly 64 hex characters.
# Generate with node crypto.randomBytes(32).toString('hex') and store in your secret manager.
# Never rotate/remove without re-enrolling authenticators; preserve in secure backup.
MFA_ENCRYPTION_KEY=""

# Funding foundation: sandbox only; never enter production NOWPayments credentials.
NOWPAYMENTS_SANDBOX_ENABLED="false"
NOWPAYMENTS_SANDBOX_API_KEY=""
NOWPAYMENTS_SANDBOX_IPN_SECRET=""
# Separate UUID allowlist; verified email + MFA session + password required for edits.
FUNDING_ADMIN_IDS=""

# Production NOWPayments credentials (server-only, Sensitive in Vercel).
# Adding these does NOT enable deposit acceptance. No live-enable flag exists yet.
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# Internal inventory-backed crypto trading (no external execution connection).
# Keep false until migration 016, independently reconciled business funding,
# reviewed directed pricing policies, and hosted concurrency checks are complete.
# Never expose as VITE_*; does not enable or automate withdrawals.
INTERNAL_TRADING_ENABLED=false

# Never add to the repository; server-only production control.
NOWPAYMENTS_LIVE_DEPOSITS_ENABLED="false"
# Never rotate/remove without re-enrolling authenticators; preserve in secure backup.
