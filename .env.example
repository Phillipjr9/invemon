# Database — PostgreSQL (Supabase or local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/invemon_wealth?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/invemon_wealth?schema=public"

# Auth — NextAuth / custom JWT
NEXTAUTH_SECRET="replace-with-64-char-random-string"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="replace-with-jwt-secret"
JWT_REFRESH_SECRET="replace-with-refresh-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS="12"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Invemon — Private wealth, quietly compounded"

# Crypto Prices — CoinGecko free tier (keyless) + optional Demo key for higher limits
NEXT_PUBLIC_COINGECKO_BASE="https://api.coingecko.com/api/v3"
COINGECKO_DEMO_API_KEY=""
# Or set VITE variant for Vite preview:
VITE_CRYPTO_API_BASE_URL="https://api.coinpaprika.com/v1"
VITE_COINGECKO_DEMO_API_KEY=""

# Google OAuth (for Vite preview)
VITE_GOOGLE_CLIENT_ID=""

# File uploads — Cloudinary (or local for demo)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email — Resend
RESEND_API_KEY=""
EMAIL_FROM="Invemon Wealth <noreply@invemon.com>"

# Rate limiting / Redis (Upstash)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Admin seed
ADMIN_EMAIL="admin@invemon.com"
ADMIN_PASSWORD="ChangeMe123!"
